# Generated by plotwork generate from the source workflows (github-actions: .github/workflows/*.yml, .github/workflows/*.yaml).
# The next run writes over this file. Put changes in docs/diagrams/workflows.overrides.json, or run plotwork generate --capture
# after an edit to keep it there, then run plotwork generate.
flow "Smoke" direction=down desc="1 job and their steps of the Smoke workflow, started by a manual run or the schedule 0 21 * * *, in the order their needs set, imported from GitHub Actions."

node on terminal "Manual run or schedule"

group job_smoke "Smoke: (preview)" type=ci-cd sub="ubuntu-latest" {
  node smoke_1 step "Checkout" icon=simple:github
  node smoke_2 step "Checkout" icon=simple:github
  node smoke_3 step "Setup go" icon=simple:go
  node smoke_4 step "Hashicorp setup terraform" icon=simple:terraform
  node smoke_5 step "Opentofu setup opentofu" icon=simple:opentofu
  node smoke_6 step "Run every example"
  node smoke_7 step "Check the Free plan's refusals"
}

on -> smoke_1
smoke_1 -> smoke_2
smoke_2 -> smoke_3
smoke_3 -> smoke_4
smoke_4 -> smoke_5
smoke_5 -> smoke_6
smoke_6 -> smoke_7
